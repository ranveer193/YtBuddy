# ==============================================================
# NoteLens Backend Environment Configuration (.env)
# ==============================================================

# Required: Primary Groq API Key
GROQ_API_KEY=your_primary_groq_api_key_here

# Optional: Backup Groq API keys for automatic key rotation on rate limits
# (comma-separated list of additional keys)
GROQ_API_KEYS=

# Optional: HuggingFace API Token for provider failover (Groq <-> HuggingFace)
HUGGINGFACEHUB_API_TOKEN=

# Primary LLM provider: groq (default) or hf
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
HF_LLM_REPO=openai/gpt-oss-120b

# Embeddings model (runs locally via sentence-transformers / HuggingFaceEmbeddings)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# CORS Origins for frontend communication
# Set to your Vercel frontend domain in production (e.g. https://notelens.vercel.app)
# Or use * to allow any frontend domain
FRONTEND_ORIGIN=*

# Optional: YouTube Cookies / Proxy for Cloud Deployments (Render / AWS / GCP)
# YouTube blocks datacenter IP ranges from downloading transcripts without cookies or proxy.
# 1. Export cookies from browser as Netscape cookies.txt and paste text here:
# YOUTUBE_COOKIES=
# 2. Or provide a proxy URL (e.g. from Webshare.io free plan):
# YOUTUBE_PROXY=http://username:password@proxy.example.com:8080

# Runtime data directory
DATA_DIR=data

# Concurrency & Token Tuning
REDUCE_TOKEN_BUDGET=3500
SHORT_VIDEO_TOKENS=8000
CONTEXT_PARTS=3

# Server Port
PORT=8000
