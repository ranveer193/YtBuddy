<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ notes.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f6fb;--card:#fff;--ink:#141926;--mute:#5c6a82;--line:#e2e7f0;--accent:#4f46e5;--accent2:#7c3aed;--soft:#eef0ff;--ok:#059669;--code-bg:#1e1e2e;--code-ink:#cdd6f4;--r:14px}
@media(prefers-color-scheme:dark){:root{--bg:#0d0f18;--card:#161b28;--ink:#e4e8f5;--mute:#8896aa;--line:#242b3c;--accent:#8b93ff;--accent2:#a78bfa;--soft:#1d2240;--code-bg:#12131f;--code-ink:#cdd6f4}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15.5px/1.75 Inter,system-ui,Segoe UI,sans-serif}
.wrap{max-width:920px;margin:0 auto;padding:52px 24px 96px}
header{margin-bottom:32px}
.eyebrow{font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:700}
h1{font-size:36px;line-height:1.18;margin:10px 0 16px;letter-spacing:-.03em;font-weight:700}
.meta{display:flex;flex-wrap:wrap;gap:8px}
.chip{font-size:12px;padding:4px 12px;border-radius:99px;background:var(--soft);color:var(--accent);font-weight:600;text-decoration:none;border:1px solid transparent;transition:.15s}
.chip:hover{border-color:var(--accent)}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:24px 28px;margin-top:20px;break-inside:avoid;transition:.2s}
.card:hover{border-color:color-mix(in srgb,var(--accent) 30%,var(--line))}

/* Section header */
.card h2{margin:0 0 4px;font-size:20px;letter-spacing:-.02em;display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}
.ts{font-size:11.5px;font-weight:700;color:var(--accent);background:var(--soft);padding:3px 10px;border-radius:99px;text-decoration:none;white-space:nowrap;flex-shrink:0;margin-top:2px}
.ts:hover{background:var(--accent);color:#fff}
.s-overview{color:var(--mute);font-size:14.5px;margin:4px 0 14px;line-height:1.6}

/* Bullets */
ul{margin:0 0 8px;padding-left:22px}li{margin:7px 0}
ul.concepts{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
ul.concepts li{background:var(--soft);color:var(--accent);font-size:12px;font-weight:600;padding:3px 11px;border-radius:99px}
.examples-list li::marker{content:"▸ ";color:var(--accent)}
.terms-list li{font-size:13.5px;color:var(--mute)}
.terms-list strong{color:var(--ink)}

/* Sub-sections */
.sub-label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);font-weight:700;margin:16px 0 6px}

/* Code blocks */
.code-block{margin:14px 0;border-radius:10px;overflow:hidden;border:1px solid var(--line)}
.code-head{background:color-mix(in srgb,var(--code-bg) 85%,#fff 15%);padding:7px 14px;display:flex;align-items:center;gap:10px;border-bottom:1px solid #ffffff18}
.code-lang{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#89b4fa;background:#ffffff12;padding:2px 8px;border-radius:5px}
.code-caption{font-size:12.5px;color:#cdd6f4;font-family:'JetBrains Mono',ui-monospace,Menlo,monospace}
pre{margin:0;overflow-x:auto;padding:16px;background:var(--code-bg);color:var(--code-ink);font:13.5px/1.6 'JetBrains Mono',ui-monospace,Menlo,monospace;tab-size:4}

/* Inline code */
code:not(pre code){background:var(--soft);color:var(--accent);padding:1px 7px;border-radius:5px;font:.875em 'JetBrains Mono',ui-monospace,Menlo,monospace}

/* Overview lead */
.lead{font-size:17px;color:var(--mute);line-height:1.7}

/* Takeaways */
.take{border-left:4px solid var(--accent);background:linear-gradient(to right,color-mix(in srgb,var(--accent) 6%,var(--card)),var(--card))}
.take h2{font-size:18px}

/* TOC */
nav.card h2{font-size:17px;margin-bottom:12px}
nav ol{columns:2;margin:0;padding-left:22px;font-size:14px;gap:24px}
nav a{color:inherit;text-decoration:none}nav a:hover{color:var(--accent)}
nav li{margin:5px 0}

/* Divider between sub-sections */
.divider{border:0;border-top:1px solid var(--line);margin:16px 0}

/* Chapter badge */
.chapter-hint{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--mute);background:var(--soft);border-radius:99px;padding:2px 10px;margin-bottom:10px}
.chapter-hint::before{content:"📑"}

/* Stats in footer */
footer{margin-top:40px;color:var(--mute);font-size:12px;text-align:center;display:flex;flex-wrap:wrap;gap:6px;justify-content:center;align-items:center}
footer span{background:var(--soft);padding:2px 10px;border-radius:99px;font-size:11.5px}

@media(max-width:640px){h1{font-size:26px}.wrap{padding:28px 16px 60px}nav ol{columns:1}}
@media print{body{background:#fff;color:#000}.card{border-color:#ccc;box-shadow:none}.wrap{padding:0}a{color:inherit}pre{border:1px solid #ccc}}
</style></head><body><div class="wrap">
<header>
  <div class="eyebrow">Study Notes</div>
  <h1>{{ notes.title }}</h1>
  <div class="meta">
    <a class="chip" href="{{ meta.url }}" target="_blank">▶ Watch video</a>
    {% if meta.channel %}<span class="chip">{{ meta.channel }}</span>{% endif %}
    {% if meta.duration %}<span class="chip">⏱ {{ meta.duration|ts }}</span>{% endif %}
    <span class="chip">{{ language }}</span>
    <span class="chip">{{ stats.chunks }} chunks</span>
  </div>
</header>

<div class="card"><p class="lead" style="margin:0">{{ notes.overview|inline }}</p></div>

<nav class="card">
  <h2>Contents</h2>
  <ol>{% for s in notes.sections %}<li><a href="#s{{ loop.index }}">{{ s.heading }}</a></li>{% endfor %}</ol>
</nav>

{% for s in notes.sections %}
<section class="card" id="s{{ loop.index }}">
  <h2>
    <span>{{ s.heading }}</span>
    {% if s.start_sec is defined %}<a class="ts" href="{{ meta.url }}&t={{ s.start_sec }}s" target="_blank">&#9654; {{ s.start_sec|ts }}</a>{% endif %}
  </h2>

  {% if s.overview %}<p class="s-overview">{{ s.overview|inline }}</p>{% endif %}

  {% if s.key_concepts %}
  <div class="sub-label">Core Concepts</div>
  <ul class="concepts">{% for c in s.key_concepts %}<li>{{ c }}</li>{% endfor %}</ul>
  {% endif %}

  {% if s.points %}
  <ul>{% for p in s.points %}{% if p %}<li>{{ p|inline }}</li>{% endif %}{% endfor %}</ul>
  {% endif %}

  {% if s.code_examples %}
  <div class="sub-label">Code Examples</div>
  {% for ce in s.code_examples %}
  <div class="code-block">
    <div class="code-head">
      {% if ce.language %}<span class="code-lang">{{ ce.language }}</span>{% endif %}
      <span class="code-caption">{{ ce.caption }}</span>
    </div>
    <pre>{{ ce.code }}</pre>
  </div>
  {% endfor %}
  {% endif %}

  {% if s.examples %}
  <div class="sub-label">Examples &amp; Analogies</div>
  <ul class="examples-list">{% for e in s.examples %}<li>{{ e|inline }}</li>{% endfor %}</ul>
  {% endif %}

  {% if s.technical_terms %}
  <div class="sub-label">Technical Terms</div>
  <ul class="terms-list">{% for t in s.technical_terms %}<li>{{ t|inline }}</li>{% endfor %}</ul>
  {% endif %}
</section>
{% endfor %}

<section class="card take">
  <h2>Key Takeaways</h2>
  <ul>{% for t in notes.key_takeaways %}<li>{{ t|inline }}</li>{% endfor %}</ul>
</section>

<footer>
  <span>Generated by NoteLens</span>
  <span>{{ stats.created }}</span>
  {% if meta.channel %}<span>{{ meta.channel }}</span>{% endif %}
</footer>
</div></body></html>
